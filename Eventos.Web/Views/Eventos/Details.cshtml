@model Eventos.Web.Models.Evento

@{
    ViewData["Title"] = "Detalles del Evento";
    var confirmados = Model.Inscripciones.Count(i => i.Estado == "Confirmada");
    var cupos = Math.Max(0, Model.Aforo - confirmados);
}

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-info text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold">
                    <i class="bi bi-info-circle me-2"></i>Detalle del Evento
                </h5>
                <span class="badge @(Model.Modalidad == "Presencial" ? "bg-primary" : "bg-warning text-dark") fs-6">
                    @Model.Modalidad
                </span>
            </div>
            <div class="card-body p-4">
                <h3 class="fw-bold text-primary mb-3">@Model.Titulo</h3>

                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted d-block small">Categoría</span>
                            <span class="fw-semibold fs-5">@(Model.Categoria?.Nombre ?? "Sin categoría")</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted d-block small">Fecha y Hora</span>
                            <span class="fw-semibold fs-5">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted d-block small">Lugar / Enlace</span>
                            <span class="fw-semibold fs-5">@Model.Lugar</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded">
                            <span class="text-muted d-block small">Precio de Entrada</span>
                            <span class="fw-semibold fs-5">@(Model.Precio == 0 ? "Gratis" : Model.Precio.ToString("C2"))</span>
                        </div>
                    </div>
                </div>

                <div class="row g-3 text-center mb-4">
                    <div class="col-md-4">
                        <div class="card bg-light border-0 shadow-sm py-2">
                            <div class="text-muted small">Aforo Total</div>
                            <div class="fs-4 fw-bold text-dark">@Model.Aforo</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-light border-0 shadow-sm py-2">
                            <div class="text-muted small">Inscritos Confirmados</div>
                            <div class="fs-4 fw-bold text-success">@confirmados</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-light border-0 shadow-sm py-2">
                            <div class="text-muted small">Cupos Disponibles</div>
                            <div class="fs-4 fw-bold @(cupos > 0 ? "text-primary" : "text-danger")">@cupos</div>
                        </div>
                    </div>
                </div>

                <h5 class="fw-bold mb-3"><i class="bi bi-people me-2"></i>Asistentes con Inscripción Confirmada</h5>
                @if (!Model.Inscripciones.Any(i => i.Estado == "Confirmada"))
                {
                    <p class="text-muted fst-italic">No hay inscripciones confirmadas aún para este evento.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Asistente</th>
                                    <th>DNI</th>
                                    <th>Correo</th>
                                    <th>Fecha de Inscripción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ins in Model.Inscripciones.Where(i => i.Estado == "Confirmada"))
                                {
                                    <tr>
                                        <td>@ins.Asistente?.Nombres</td>
                                        <td>@ins.Asistente?.Dni</td>
                                        <td>@ins.Asistente?.Correo</td>
                                        <td>@ins.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Volver al listado
                    </a>
                    <div>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                            <i class="bi bi-pencil me-1"></i>Editar
                        </a>
                        <a asp-controller="Inscripciones" asp-action="Create" class="btn btn-success">
                            <i class="bi bi-plus-circle me-1"></i>Inscribir Asistente
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
