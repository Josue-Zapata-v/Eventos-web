@model Eventos.Web.Models.Evento

@{
    ViewData["Title"] = "Eliminar Evento";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="card-title mb-0 fw-bold">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Eliminación Lógica
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning mb-4">
                    <i class="bi bi-info-circle me-1"></i>
                    Esta acción marcará el evento como inactivo (eliminación lógica: <code>Activo = false</code>). No se realizará ningún borrado físico en la base de datos.
                </div>

                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Título:</dt>
                    <dd class="col-sm-8 fw-bold text-dark">@Model.Titulo</dd>

                    <dt class="col-sm-4 text-muted">Categoría:</dt>
                    <dd class="col-sm-8">@(Model.Categoria?.Nombre ?? "Sin categoría")</dd>

                    <dt class="col-sm-4 text-muted">Fecha y Hora:</dt>
                    <dd class="col-sm-8">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4 text-muted">Lugar:</dt>
                    <dd class="col-sm-8">@Model.Lugar</dd>

                    <dt class="col-sm-4 text-muted">Modalidad:</dt>
                    <dd class="col-sm-8">@Model.Modalidad</dd>

                    <dt class="col-sm-4 text-muted">Aforo:</dt>
                    <dd class="col-sm-8">@Model.Aforo</dd>

                    <dt class="col-sm-4 text-muted">Precio:</dt>
                    <dd class="col-sm-8">@(Model.Precio == 0 ? "Gratis" : Model.Precio.ToString("C2"))</dd>
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i>Cancelar
                        </a>
                        <button type="submit" class="btn btn-danger px-4 fw-semibold">
                            <i class="bi bi-trash-fill me-1"></i>Confirmar Eliminación
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
