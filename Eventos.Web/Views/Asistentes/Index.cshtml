@model IEnumerable<Eventos.Web.Models.Asistente>

@{
    ViewData["Title"] = "Listado de Asistentes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark"><i class="bi bi-people-fill text-primary me-2"></i>Asistentes Registrados</h2>
        <p class="text-muted mb-0">Directorio de asistentes activos ordenados alfabéticamente por nombres.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="bi bi-person-plus me-1"></i>Nuevo Asistente
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info py-4 text-center">
        <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
        No se encuentran asistentes registrados en el sistema.
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombres Completos</th>
                        <th>DNI</th>
                        <th>Correo Electrónico</th>
                        <th>Teléfono</th>
                        <th class="text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong class="text-dark">@item.Nombres</strong>
                            </td>
                            <td>
                                <span class="badge bg-secondary font-monospace">@item.Dni</span>
                            </td>
                            <td>
                                <a href="mailto:@item.Correo" class="text-decoration-none">
                                    <i class="bi bi-envelope me-1 text-muted"></i>@item.Correo
                                </a>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Telefono))
                                {
                                    <span><i class="bi bi-telephone me-1 text-muted"></i>@item.Telefono</span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">No registrado</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge bg-success">Activo</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
